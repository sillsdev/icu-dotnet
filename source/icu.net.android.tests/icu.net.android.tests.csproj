<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Override Directory.Build.props multi-targeting; Android device tests only -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>icu.net.android.tests</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<SignAssembly>false</SignAssembly>

		<ApplicationTitle>icu.net Android Tests</ApplicationTitle>
		<ApplicationId>com.sil.icu.android.tests</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">false</EmbedAssembliesIntoApk>

		<!-- The MAUI app defines its own entry point via DeviceRunners -->
		<GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>

		<!-- Gitignored ICU build output from scripts/build-icu-android.ps1 -->
		<AndroidIcuLibDir>$(MSBuildThisFileDirectory)..\..\output\android-icu</AndroidIcuLibDir>
	</PropertyGroup>

	<ItemGroup Condition="Exists('$(AndroidIcuLibDir)\icudt72l.dat')">
		<AndroidAsset Include="$(AndroidIcuLibDir)\icudt72l.dat" LogicalName="icudt72l.dat" />
	</ItemGroup>

	<!-- Android APKs require native libs to end in .so (not .so.72). See scripts/build-icu-android.sh install_android_apk_libs. -->
	<ItemGroup Condition="Exists('$(AndroidIcuLibDir)\x86_64\libicuuc.so')">
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86_64\libc++_shared.so" Condition="Exists('$(AndroidIcuLibDir)\x86_64\libc++_shared.so')" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86_64\libicuuc.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86_64\libicui18n.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86_64\libicudata.so" />
	</ItemGroup>
	<ItemGroup Condition="Exists('$(AndroidIcuLibDir)\arm64-v8a\libicuuc.so')">
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\arm64-v8a\libc++_shared.so" Condition="Exists('$(AndroidIcuLibDir)\arm64-v8a\libc++_shared.so')" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\arm64-v8a\libicuuc.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\arm64-v8a\libicui18n.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\arm64-v8a\libicudata.so" />
	</ItemGroup>
	<ItemGroup Condition="Exists('$(AndroidIcuLibDir)\armeabi-v7a\libicuuc.so')">
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\armeabi-v7a\libc++_shared.so" Condition="Exists('$(AndroidIcuLibDir)\armeabi-v7a\libc++_shared.so')" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\armeabi-v7a\libicuuc.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\armeabi-v7a\libicui18n.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\armeabi-v7a\libicudata.so" />
	</ItemGroup>
	<ItemGroup Condition="Exists('$(AndroidIcuLibDir)\x86\libicuuc.so')">
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86\libc++_shared.so" Condition="Exists('$(AndroidIcuLibDir)\x86\libc++_shared.so')" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86\libicuuc.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86\libicui18n.so" />
		<AndroidNativeLibrary Include="$(AndroidIcuLibDir)\x86\libicudata.so" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\icu.net\icu.net.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DeviceRunners.Testing.Targets" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.VisualRunners.Maui" Version="0.1.0-preview.12" />
		<PackageReference Include="DeviceRunners.VisualRunners.Xunit" Version="0.1.0-preview.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
	</ItemGroup>

	<!-- Prevent the Android linker from stripping test classes discovered via reflection -->
	<ItemGroup>
		<TrimmerRootAssembly Include="icu.net.android.tests" RootMode="all" />
	</ItemGroup>

</Project>
